# DocVault Backend Environment Configuration

# Server Port & Environment
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/docvault?retryWrites=true&w=majority

# Groq Cloud API (Llama 3.3 / Qwen / Llama 3.2 Vision OCR & Semantic Extraction)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API (Embeddings & Semantic Vector generation)
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Cloudflare R2 Object Storage (S3-compatible secure external vault storage)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# Firebase / Google Cloud Storage Service Account (Alternative Storage Option)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app

# JWT Secret for Session Authentication & PIN Unlock
JWT_SECRET=your_super_secret_jwt_key_here

# Email Delivery Configuration for Cloud Deployment (Render / Vercel / Heroku)
# OPTION A (RECOMMENDED FOR RENDER): Resend HTTP API (Operates over Port 443 HTTPS - NEVER blocked by cloud firewalls)
# Get a free key in 1 minute from https://resend.com (3,000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="DocVault Security" <onboarding@resend.dev>

# OPTION B: Gmail SMTP (Note: Render Free Tier blocks outbound SMTP ports 25, 465, and 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="DocVault Security" <your_email@gmail.com>

